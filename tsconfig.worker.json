{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "shared/**/*.ts",
    "tests/helpers/**/*.ts",
    "tests/unit/signalJob.test.ts",
    "tests/unit/worker.test.ts",
    "worker/**/*.ts"
  ]
}